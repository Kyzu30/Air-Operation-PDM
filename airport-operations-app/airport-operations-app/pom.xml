<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.group7</groupId>
    <artifactId>airport-operations-app</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <name>Airport Operations App (Group 7)</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- NetBeans "Run Project" uses this main class -->
        <exec.mainClass>com.group7.airport.App</exec.mainClass>
    </properties>

    <dependencies>
        <!-- MySQL JDBC driver (downloaded automatically by Maven) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The Task 6 query script is also packed into the jar (as /queries/...), so the
                 Reports tab still works when the jar is started from another folder.
                 There is only one copy to edit: sql/02_AirportOperation_queries.sql -->
            <resource>
                <directory>sql</directory>
                <includes>
                    <include>02_AirportOperation_queries.sql</include>
                </includes>
                <targetPath>queries</targetPath>
            </resource>
        </resources>
        <plugins>
            <!-- `mvn package` builds target/airport-operations-app-1.0-jar-with-dependencies.jar (double-click to run) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifest>
                            <mainClass>com.group7.airport.App</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
